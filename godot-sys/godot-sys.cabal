cabal-version:      3.0
name:               godot-sys
version:            0.1.0.0
synopsis:           Godot Engine built as a native library (libgodot)
description:
  Builds a pinned version of the Godot Engine as a library (@libgodot@)
  using Godot's own SCons build, and exposes it to Haskell.
  .
  The Godot version is pinned in "Setup.hs" (tag, download URL and SHA-256).
  .
  Cabal flags:
  .
  * @shared@ — build @libgodot.so@ instead of the default static @libgodot.a@.
  .
  * @release@ — build the @template_release@ target instead of @template_debug@.
  .
  * Godot's build options: a flag per option, named after it with @-@ for
    @_@ and with the same default, e.g. @disable-3d@ for @disable_3d@ (off)
    and @vulkan@ (on). The other options can be set through
    @GODOT_SYS_SCONS_FLAGS@.
  .
  Environment variables (read at build time):
  .
  * @GODOT_SYS_CACHE_DIR@ — where the Godot source and builds are kept, so
    that other build directories (e.g. the Haskell Language Server's) reuse
    them (default: @~/.cache/godot-sys@).
  .
  * @GODOT_SYS_SOURCE_DIR@ — use an existing, unpacked Godot source tree
    instead of downloading the pinned tarball. It must be the pinned version.
    Builds from it are not cached.
  .
  * @GODOT_SYS_TARBALL@ — use a local copy of the pinned tarball (still
    checked against the pinned SHA-256).
  .
  * @GODOT_SYS_JOBS@ — number of parallel SCons jobs (default: CPU count).
  .
  * @GODOT_SYS_SCONS_FLAGS@ — extra, space-separated SCons arguments.
license:            MIT
license-file:       LICENSE
author:             David Eichmann
maintainer:         eichmannd@gmail.com
category:           Game Engine, FFI
build-type:         Custom
extra-doc-files:    README.md
extra-source-files:
  extension_api.json
  scripts/update-extension-api.sh
  tools/list-classes.c
tested-with:        GHC == 9.12.2

source-repository head
  type:     git
  location: .
  subdir:   godot-sys

flag shared
  description: Build Godot as a shared library (libgodot.so) instead of a static one (libgodot.a).
  default:     False
  manual:      True

flag release
  description: Build Godot's template_release target instead of template_debug.
  default:     False
  manual:      True

flag disable-3d
  description: Remove 3D nodes, rendering and resources (Godot's disable_3d build option).
  default:     False
  manual:      True

flag disable-advanced-gui
  description: Remove advanced GUI controls (Tree, TextEdit, RichTextLabel, PopupMenu, dialogs, ...) (Godot's disable_advanced_gui build option).
  default:     False
  manual:      True

flag disable-physics-2d
  description: Remove 2D physics (Godot's disable_physics_2d build option).
  default:     False
  manual:      True

flag disable-physics-3d
  description: Remove 3D physics (Godot's disable_physics_3d build option).
  default:     False
  manual:      True

flag disable-navigation-2d
  description: Remove 2D navigation (Godot's disable_navigation_2d build option).
  default:     False
  manual:      True

flag disable-navigation-3d
  description: Remove 3D navigation (Godot's disable_navigation_3d build option).
  default:     False
  manual:      True

flag disable-xr
  description: Remove XR (VR/AR) (Godot's disable_xr build option).
  default:     False
  manual:      True

flag vulkan
  description: Build with the Vulkan rendering driver (Godot's vulkan build option).
  default:     True
  manual:      True

flag opengl3
  description: Build with the OpenGL/GLES3 rendering driver (Godot's opengl3 build option).
  default:     True
  manual:      True

flag accesskit
  description: Build with the AccessKit screen reader driver (Godot's accesskit build option).
  default:     True
  manual:      True

flag sdl
  description: Build with the SDL3 input driver (game controllers) (Godot's sdl build option).
  default:     True
  manual:      True

flag brotli
  description: Build with Brotli decompression and WOFF2 fonts (Godot's brotli build option).
  default:     True
  manual:      True

flag x11
  description: Build with X11 display (Godot's x11 build option).
  default:     True
  manual:      True

flag wayland
  description: Build with Wayland display (Godot's wayland build option).
  default:     True
  manual:      True

flag pulseaudio
  description: Build with PulseAudio (Godot's pulseaudio build option).
  default:     True
  manual:      True

flag alsa
  description: Build with ALSA (Godot's alsa build option).
  default:     True
  manual:      True

custom-setup
  setup-depends:
    , base       >=4.14 && <5
    , Cabal      >=3.14 && <3.17
    , directory  >=1.3  && <1.4
    , filepath   >=1.4  && <1.6
    , process    >=1.6  && <1.7

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:  Godot.Sys
  hs-source-dirs:   src
  build-depends:    base >=4.14 && <5
  default-language: Haskell2010

  -- Setup.hs adds the Godot library itself (extra-libraries: godot), its
  -- system dependencies, include-dirs for libgodot.h, and (with +shared) an
  -- rpath. Those depend on build-time paths, so they cannot be written here.

test-suite godot-sys-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  c-sources:        test/cbits/init.c
  build-depends:
    , base       >=4.14 && <5
    , directory
    , filepath
    , godot-sys
  ghc-options:      -threaded
  default-language: Haskell2010
