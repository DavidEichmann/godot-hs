cabal-version:      3.0
name:               godot-low
version:            0.1.0.0
synopsis:           Low-level GDExtension bindings to Godot, generated from godot-sys
description:
  Low-level Haskell bindings to the Godot Engine's GDExtension interface.
  .
  The bindings are generated at build time (by "Setup.hs") from the
  @gdextension_interface.json@ installed by the godot-sys package, so they
  always match the Godot version godot-sys builds.
  .
  * "Godot.Low.Types": handles, enums, structs (with 'Storable' instances
    whose layout comes from the C header) and function pointer types.
  .
  * "Godot.Low.Interface": every GDExtension interface function, loaded
    through Godot's @get_proc_address@.
  .
  * "Godot.Low": re-exports both, plus typed libgodot entry points.
license:            MIT
license-file:       LICENSE
author:             David Eichmann
maintainer:         eichmannd@gmail.com
category:           Game Engine, FFI
build-type:         Custom
extra-doc-files:    README.md
tested-with:        GHC == 9.12.2

source-repository head
  type:     git
  location: .
  subdir:   godot-low

custom-setup
  setup-depends:
    , aeson       >=2.0  && <2.4
    , base        >=4.14 && <5
    , Cabal       >=3.14 && <3.17
    , containers  >=0.6  && <0.9
    , directory   >=1.3  && <1.4
    , filepath    >=1.4  && <1.6

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
    Godot.Low
    Godot.Low.Interface
    Godot.Low.Types
  -- Generated by Setup.hs into the autogen directory.
  autogen-modules:
    Godot.Low.Interface
    Godot.Low.Types
  hs-source-dirs:   src
  build-depends:
    , base       >=4.14 && <5
    , godot-sys  ==0.1.*
  default-language: Haskell2010

test-suite godot-low-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base       >=4.14 && <5
    , directory
    , filepath
    , godot-low
  ghc-options:      -threaded
  default-language: Haskell2010
