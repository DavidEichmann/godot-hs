cabal-version:      3.0
name:               godot-low-example
version:            0.1.0.0
synopsis:           Hello world UI using godot-low
description:
  A minimal example of embedding Godot with godot-low: it opens a window
  and shows a centred "Hello, World!" label, built from Haskell through
  the generated "Godot.Api" bindings.
license:            MIT
license-file:       LICENSE
author:             David Eichmann
maintainer:         eichmannd@gmail.com
category:           Game Engine, Example
build-type:         Simple
extra-doc-files:    README.md
tested-with:        GHC == 9.12.2

source-repository head
  type:     git
  location: .
  subdir:   godot-low-example

executable godot-low-example
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , base       >=4.14 && <5
    , directory  >=1.3  && <1.4
    , filepath   >=1.4  && <1.6
    , godot-low  ==0.1.*
  ghc-options:      -Wall -threaded
  default-language: Haskell2010
